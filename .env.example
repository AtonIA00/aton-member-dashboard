# Aton Member Dashboard — variáveis de ambiente (exemplo).
#
# Local: copie pra `.env.local` e preencha. `.env.local` é gitignored.
# Produção: as vars vivem em /root/aton-member-dashboard/.env.local NO SERVIDOR
#   (72.61.217.72). O workflow deploy.yml reaplica TODAS via `docker service
#   update --env-add` a cada deploy — então mudança de env em prod = editar
#   aquele arquivo + redeployar (ou docker service update). Ver README §Deploy.

# ── Supabase (base compartilhada "Base de Dados Aton Hub") ─────────────────
# NEXT_PUBLIC_* são inlinados no bundle client em build time (entram como
# --build-arg no deploy.yml). Os demais são server-only.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=https://member-dashboard.aton-ia.com.br
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # bypassa RLS — nunca expor ao client

# ── HMAC do iframe Uchat ───────────────────────────────────────────────────
# Mesma chave do Aton WA (Whitelabel Uchat). Valida workspace_id/user_id/
# timestamp/signature de cada request do iframe.
UCHAT_PRIVATE_KEY=your-uchat-private-key-here

# ── Aton Core (server-to-server, cost-shifting + métricas) ─────────────────
# Canal interno pros endpoints do Core: /api/internal/openai-key (TON) e
# /api/internal/retorno-comercial. Mesmo INTERNAL_SHARED_SECRET (Bearer).
ATON_CORE_INTERNAL_URL=https://core.atonbot.cc
INTERNAL_SHARED_SECRET=your-internal-shared-secret-here

# OpenAI de teste — fallback do TON em dev quando o Core não está configurado.
OPENAI_TEST_KEY=

# ── Feature flags ──────────────────────────────────────────────────────────
# Convenção: MEMBER_DASHBOARD_<FEATURE>_ENABLED, string "true" liga (qualquer
# outro valor / ausente = desligado). Permite subir código DARK (mergeado em
# prod, invisível) e acender depois só setando a var no .env.local do servidor
# + `docker service update --env-add ...`. Sem rebuild.
#
# TON (aba de IA assessor) liberado pra tier `pro` além de enterprise:
MEMBER_DASHBOARD_TON_PRO_ENABLED=false
# Seção "Retorno do time comercial" (kill-switch global; dado vem do Core).
# Toggle POR ASSINANTE fica em wa_member_dashboard_access.mostrar_retorno_comercial.
MEMBER_DASHBOARD_RETORNO_COMERCIAL_ENABLED=false
# Dev/preview: devolve dados de exemplo em vez de chamar o Core (só local).
MEMBER_DASHBOARD_RETORNO_COMERCIAL_MOCK=false
